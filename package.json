{
  "name": "mermlinter",
  "version": "0.2.0",
  "description": "Fast, agent-friendly MermaidJS linter for snippets, Markdown fences, and Obsidian notes.",
  "type": "module",
  "bin": {
    "mermlint": "./dist/mermlint.js"
  },
  "files": [
    "dist/",
    "agent-skills/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:source": "MERMLINT_TEST_SOURCE=1 node --test test/*.test.js",
    "build": "node scripts/build.js",
    "bench": "node bench/run.js",
    "profile": "node bench/profile.js",
    "bench:compare": "node bench/compare.js",
    "bench:comparison": "node bench/comparison.js",
    "check:dist": "node scripts/check-dist.js",
    "test:package": "node scripts/package-smoke.js"
  },
  "keywords": [
    "mermaid",
    "mermaidjs",
    "linter",
    "markdown",
    "obsidian",
    "agent"
  ],
  "author": "Aadit Agrawal",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "linkedom": "0.18.13",
    "mermaid": "12.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaditagrawal/mermlint.git"
  },
  "bugs": {
    "url": "https://github.com/aaditagrawal/mermlint/issues"
  },
  "homepage": "https://github.com/aaditagrawal/mermlint#readme",
  "packageManager": "bun@1.4.3"
}
